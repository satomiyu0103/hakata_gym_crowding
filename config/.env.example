# Google スプレッドシート ID（URL の /d/ と /edit の間）
SPREADSHEET_ID=your_spreadsheet_id_here

# サービスアカウント JSON 鍵（config/ 配下・Git 除外）
GOOGLE_APPLICATION_CREDENTIALS=config/service-account.json

# タイムゾーン（既定: Asia/Tokyo）
TIMEZONE=Asia/Tokyo

# 書き込み先シート名
SHEET_NAME=混雑履歴

# ログファイル（既定: logs/run.log）
LOG_FILE=logs/run.log

# Slack Incoming Webhook（任意・空なら通知しない）
SLACK_WEBHOOK_URL=

# 通知の有効化（既定: true。false で URL があっても送らない）
SLACK_NOTIFY_ENABLED=true
